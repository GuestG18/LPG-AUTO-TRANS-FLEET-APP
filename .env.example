APP_ENV=local
APP_DEBUG=false
APP_URL=https://flota.example.ro

# Authentication
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_VERIFY_RESEND_COOLDOWN_SECONDS=30
# Keep false outside local development. When true and APP_ENV is not production,
# the login code is shown on screen only if SMTP delivery fails.
AUTH_SHOW_LOGIN_CODE_ON_EMAIL_FAILURE=false

# SMTP sender mailbox used by the app
MAIL_HOST=smtp.your-company-provider.ro
MAIL_PORT=587
MAIL_USERNAME=sender@your-company.ro
MAIL_PASSWORD=replace_with_real_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sender@your-company.ro
MAIL_FROM_NAME="Your Company"
MAIL_RETURN_PATH=sender@your-company.ro
MAIL_TIMEOUT=45
MAIL_CONNECT_TIMEOUT=15
MAIL_RETRY_ATTEMPTS=2
MAIL_RETRY_DELAY_MS=400

# --- Aprobare prin email (reply-based) ---
# Permite aprobarea cererilor raspunzand la email, fara acces la aplicatie.
# Worker-ul citeste casuta de mai jos prin IMAP si aplica decizia in baza de date.
APPROVAL_EMAIL_ENABLED=false
# Casuta unde ajung raspunsurile. Trebuie sa accepte sub-addressing (adresa+tag@domeniu).
APPROVAL_INBOX_ADDRESS=aprobari@your-company.ro
APPROVAL_INBOX_IMAP_HOST=imap.migadu.com
APPROVAL_INBOX_IMAP_PORT=993
APPROVAL_INBOX_USERNAME=aprobari@your-company.ro
APPROVAL_INBOX_PASSWORD=
APPROVAL_INBOX_FOLDER=INBOX
# Mod test: trimite toate cererile doar catre adresa asta. Lasa gol in productie.
APPROVAL_MAIL_TO=
# Adrese care nu primesc niciodata cereri de aprobare (lista separata prin virgula).
APPROVAL_MAIL_EXCLUDE=
APPROVAL_TOKEN_TTL_DAYS=7
APPROVAL_MAX_SEND_PER_RUN=10

# Gmail (fara casuta noua, prin plus-addressing):
# APPROVAL_INBOX_ADDRESS=contul-tau@gmail.com
# APPROVAL_INBOX_IMAP_HOST=imap.gmail.com

# Migadu example:
# MAIL_HOST=smtp.migadu.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=sender@your-domain.ro
# MAIL_FROM_ADDRESS=sender@your-domain.ro
# MAIL_RETURN_PATH=sender@your-domain.ro

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASS=replace_with_database_password
DB_CHARSET=utf8mb4

# CardOil Avantaj API
CARDOIL_USERNAME=replace_with_cardoil_username
CARDOIL_API_KEY=replace_with_cardoil_api_key
CARDOIL_API_BASE_URL=https://api.cardoilavantaj.ro
CARDOIL_API_FILLUPS_ENDPOINT=/alimentari/preluare_alimentari_v.2.4.php
CARDOIL_API_METHOD=GET
CARDOIL_API_TIMEOUT=15
# off = nu inventa alimentari demo daca API-ul nu raspunde
CARDOIL_DEMO_MODE=off

# SAS Fleet API (GPS tracking) - https://sasrest.docs.apiary.io
# Autentificarea foloseste user + parola; tokenul este obtinut automat la login.
SAS_API_USERNAME=replace_with_sas_username
SAS_API_PASSWORD=replace_with_sas_password
# Optional: fixeaza host-ul companiei (ex. www10.alarma.ro) pentru a sari peste
# pasul de descoperire prin loginservice. Lasa gol pentru descoperire automata.
SAS_API_HOST=
# Optional: URL-ul serviciului de descoperire host (valoarea implicita este cea oficiala).
SAS_API_LOGIN_SERVICE_URL=https://fleetlogin-webapp.azurewebsites.net/LoginService.svc
# Optional: cultura mesajelor SAS (ro-RO sau en-US).
SAS_API_CULTURE=ro-RO
# Optional: timeout HTTP in secunde (3-60).
SAS_API_TIMEOUT=15

# OCR.Space (sandbox dev ?page=dev_ocr_test). Cheia gratuita: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=your_key_here
# Optional: timeout HTTP in secunde (10-120, implicit 60).
OCR_SPACE_TIMEOUT=60

# Facturi scanate: citire Gmail (IMAP, parola de aplicatie Google, fara spatii)
INVOICE_IMAP_HOST=imap.gmail.com
INVOICE_IMAP_PORT=993
INVOICE_IMAP_USERNAME=replace-with-gmail-address
INVOICE_IMAP_PASSWORD=replace-with-google-app-password
INVOICE_IMAP_FOLDER=INBOX
# Doar emailurile de la acest expeditor care vin de la scanner (subiect SAU text din corp; ghilimele: au spatii).
INVOICE_IMAP_SENDER=replace-with-scanner-sender-address
INVOICE_IMAP_SUBJECT_PREFIX="Send data from MFP"
# Textul pus de scanner in corpul emailului (ramane si cand operatorul scrie alt subiect).
INVOICE_IMAP_BODY_MARKER="Scanned from MFP"
# Etichete Gmail puse dupa preluare (emailul ramane in Inbox).
INVOICE_IMAP_LABEL_DONE=Facturi/Procesat
INVOICE_IMAP_LABEL_ERROR=Facturi/Eroare
# Cat de departe in trecut se uita la prima rulare / dupa o pauza (zile).
INVOICE_IMAP_LOOKBACK_DAYS=7

# Facturi scanate: citire (OCR) cu Claude. Aceeasi cheie si model si pentru Registrul de piese
# (?page=ocr_piese): scanarile cu subiectul "piese" / "service" / "reparatii" / "revizie" merg acolo.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
INVOICE_OCR_MODEL=claude-sonnet-5-5
