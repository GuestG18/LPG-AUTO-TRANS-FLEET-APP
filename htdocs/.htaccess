Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^api/concedii/calendar/?$ index.php?page=programare_concedii&action=api_calendar [QSA,L]
    RewriteRule ^api/concedii/([0-9]+)/?$ index.php?page=programare_concedii&action=api_item&id=$1 [QSA,L]
    RewriteRule ^api/concedii/?$ index.php?page=programare_concedii&action=api_collection [QSA,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?page=$1 [QSA,L]
</IfModule>
